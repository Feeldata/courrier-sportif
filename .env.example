# Copy to .env.local for local development. Never commit .env.local.

# Runtime environment identity.
NEXT_PUBLIC_APP_ENV=local

# Public Supabase connection values. Safe for browser use only with the intended RLS model.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Operational project identifier used by type-generation tooling. Not a secret.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Server-only credential for trusted INGEST / AI / MATCH writes and APP server reads
# while DATA V0.1 has RLS enabled without public SELECT policies.
# Never expose as NEXT_PUBLIC_* and never commit a real value.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
