# Copy to .env.local for local development. Never commit .env.local.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Used only by the type-generation script / CI. This is a project identifier, not a secret.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Server-only credential for trusted INGEST writes and APP reads while public RLS SELECT policies are not yet provisioned.
# Never expose as NEXT_PUBLIC_* and never commit a real value.
# Use a Supabase secret key (preferred) or equivalent server credential provisioned by CS COMMAND.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
