{
  "name": "courrier-sportif",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "db:types": "bash scripts/generate-supabase-types.sh",
    "check": "npm run verify:foundation && npm run verify:app && npm run check:boundaries && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "test:ingest:core": "node --experimental-strip-types --test src/modules/ingest/*.node.test.ts",
    "ingest:fecafoot:dry-run": "node --experimental-strip-types src/modules/ingest/cli.ts --dry-run --fixture src/modules/ingest/fixtures/fecafoot-elite-one-launch-2026.json",
    "ingest:fecafoot": "node --experimental-strip-types src/modules/ingest/cli.ts",
    "test:app:core": "vitest run src/modules/app/read-model.test.ts src/components/app/components.test.tsx",
    "verify:app": "node scripts/verify-app.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "typescript": "6.0.2",
    "vitest": "5.0.1"
  }
}
